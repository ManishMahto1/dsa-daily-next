{
  "name": "dsa-daily-next",
  "version": "1.0.0",
  "private": true,
  "description": "Single-user daily DSA mailer — Next.js + MongoDB + Redis + BullMQ + Gemini (question generation) + Resend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "worker": "tsx watch src/worker/index.ts",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:start": "node dist-worker/worker/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "marked": "^18.0.14",
    "mongoose": "^8.5.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
