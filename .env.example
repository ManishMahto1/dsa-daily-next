# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/dsa-daily-next

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Gemini (question auto-generation) — https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# Resend (email) — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=DSA Bot <dsa@yourdomain.com>
RECIPIENT_EMAIL=you@example.com

# Scheduling
TIMEZONE=Asia/Kolkata
DAILY_CRON=0 20 * * *

# Where the Next.js app itself is hosted — used to build the email link
FRONTEND_BASE_URL=http://localhost:3000

# Shared secret to protect the manual trigger route
DEV_TRIGGER_SECRET=changeme
