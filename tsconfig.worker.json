{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "dist-worker",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src/worker/**/*.ts",
    "src/lib/**/*.ts",
    "src/models/**/*.ts",
    "src/modules/**/*.ts",
    "src/queues/**/*.ts",
    "src/jobs/**/*.ts"
  ],
  "exclude": ["src/app/**/*", "node_modules", "dist-worker"]
}
